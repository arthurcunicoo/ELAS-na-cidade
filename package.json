    "test:architecture": "node tests/architecture-flows.mjs",
    "test:spatial": "node tests/spatial-db.mjs && node tests/spatial-ui.mjs && node tests/catalog-worker.mjs && node tests/atomic-ingestion.mjs",
    "test:cursor": "node tests/cursor-db.mjs && node tests/cursor-ui.mjs",
    "test:cancellation": "node tests/request-cancellation.mjs",
    "test:web-map": "node tests/web-map.mjs",
    "qa:doctor": "node --env-file-if-exists=.env scripts/qa/doctor.mjs",
    "qa:android": "node scripts/qa/device.mjs",
    "qa:ios": "node scripts/qa/ios-device.mjs",
    "qa:visual": "node scripts/qa/visual.mjs",
    "qa:performance": "node scripts/qa/perf-android.mjs",
    "release:check": "node --env-file-if-exists=.env scripts/qa/release-check.mjs",
    "test:restore": "node tests/restore-drill.mjs",
    "test:operations": "node tests/operations.mjs && node tests/qa-environment.mjs && node tests/browser-fixture.mjs",
    "eas-build-post-install": "node scripts/qa/build-check.mjs",
    "test:load-protocol": "node tests/load-protocol.mjs",
    "test:growth": "node tests/operational-growth.mjs && node tests/push-client.mjs",
    "test:audit": "node tests/audit-regressions.mjs",
    "test:loading": "node tests/loading-motion.mjs && node tests/tab-transition.mjs && node tests/web-tab-transition.mjs",
    "test:modernization": "node tests/modernization.mjs",
    "test:map-benchmark": "node tests/map-benchmark.mjs",
    "test:interface": "node tests/interface.mjs",
    "test:system": "node tests/native-storage.mjs && node tests/system-security.mjs && node tests/system-dependencies.mjs && node tests/system-database.mjs && node tests/report-submission.mjs && node tests/storage-concurrency.mjs && node tests/erasure-admin.mjs",
    "qa:backend-readiness": "node --env-file-if-exists=.env scripts/operations/readiness.mjs",
    "qa:staging-permissions": "node scripts/operations/staging-permissions.mjs",
    "test:browser": "node tests/browser-storage.mjs",
    "test:admin": "node tests/admin-access.mjs && node tests/admin-roles-db.mjs",
    "test:edge": "deno check --no-config --no-lock --cached-only --node-modules-dir=manual supabase/functions/lugares-osm/index.ts supabase/functions/catalog-refresh/index.ts supabase/functions/push-delivery/index.ts supabase/functions/account-erasure/index.ts",
    "qa:welcome": "node scripts/qa/run-welcome.mjs",
    "qa:tabs": "node scripts/qa/run-welcome.mjs tests/tab-browser.mjs",
    "qa:expo-go": "node scripts/qa/run-welcome.mjs tests/expo-go-compat.mjs"
