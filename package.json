    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "2.117.1",
    "base64-arraybuffer": "1.0.2",
    "decode-uri-component": "file:vendor/decode-uri-component",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
