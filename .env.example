# O modo de apresentação já inclui a configuração pública do ELAS.
# Para outro projeto, copie para .env e preencha URL e chave do mesmo projeto.
# Produção/staging exigem configuração explícita; nunca use service_role/secret.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Também aceita a chave pública legada em EXPO_PUBLIC_SUPABASE_ANON_KEY.

# Presentation uses real authenticated data; fictional samples are disabled.
EXPO_PUBLIC_SHOWCASE=0
EXPO_PUBLIC_DEMO=0
# Fully offline demo: npm run demo

# Web map: HTTPS XYZ raster tiles (256px), with provider attribution.
# Public browser key only, restricted by domain and quota at your provider.
EXPO_PUBLIC_MAP_TILE_URL=
EXPO_PUBLIC_MAP_TILE_ATTRIBUTION=
EXPO_PUBLIC_MAP_TILE_ATTRIBUTION_URL=
EXPO_PUBLIC_MAP_TILE_MAX_ZOOM=19
# Explicitly opt in ONLY for the small pilot; use your provider for public growth.
# EXPO_PUBLIC_MAP_TILE_MODE=pilot

# Release monitoring (DSN is public; upload token must be a secret in EAS only).
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SENTRY_DSN=
# Build-time environment, configured in EAS; do not paste admin tokens into the app.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# EAS_PROJECT_ID=
# GOOGLE_MAPS_ANDROID_API_KEY=

# Optional native push build config: EAS file variable for the matching Android package.
# GOOGLE_SERVICES_JSON=
# EXPO_ACCESS_TOKEN belongs only to Edge Function secrets, never to EXPO_PUBLIC_.

# IANA timezone for the service-wide events (e.g. America/Manaus).
EXPO_PUBLIC_SERVICE_TIMEZONE=America/Sao_Paulo

# Enable only after staging migration + account-erasure Edge validation/deploy.
EXPO_PUBLIC_ACCOUNT_ERASURE_ENABLED=false
